# DockTender backend environment
# Persistence — SQLite for the demo; set a Postgres URL for real persistence.
DATABASE_URL=sqlite:///./docktender.db
# Seed the demo tenant at boot (default on for SQLite). Set 0 for a blank instance.
DEMO_SEED=1
# JWT signing secret — CHANGE THIS in production.
JWT_SECRET=dev-secret-change-me-in-production
# AI assistant + bid parser (optional; /api/ai/* returns 503 without it).
ANTHROPIC_API_KEY=
# Optional: PassagePilot routing API for real deviation distance in TEC.
ROUTING_API_URL=
